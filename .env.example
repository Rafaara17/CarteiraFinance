# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# (Supabase Dashboard → Project Settings → API)
#
# A chave ANON é PÚBLICA de propósito — ela vai embutida no site. A segurança
# real é a RLS do banco (ver supabase/schema.sql). NUNCA coloque a service_role
# key aqui: ela é secreta e só entra nos secrets da GitHub Action.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-a-sua-anon-key-aqui
